# Copy to .env.local in each app or export locally. Never commit real values.
# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/azadimart?sslmode=require

# Auth — generate unique secrets per environment
AUTH_SECRET=replace-with-32-plus-character-secret
AUTH_URL_STOREFRONT=http://localhost:3000
AUTH_URL_SELLER=http://localhost:3001
AUTH_URL_ADMIN=http://localhost:3002

# Bot check (Cloudflare Turnstile) on login and registration.
# Leave both empty to disable. Get free keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (always pass)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Object storage (S3-compatible: Cloudflare R2, AWS S3). Required in production
# for KYC documents and product media; keep the bucket PRIVATE (apps stream files).
# R2: STORAGE_REGION=auto, STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Leave bucket/keys empty in development to use a shared local folder
# (LOCAL_STORAGE_DIR, default <repo root>/.data).
STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Payments — leave empty until a provider is configured
PAYMENTS_DEFAULT_PROVIDER=cod
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Logistics — leave empty until a provider is configured
LOGISTICS_DEFAULT_PROVIDER=manual
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_API_TOKEN=
SHADOWFAX_API_KEY=

# Observability
LOG_LEVEL=info
NODE_ENV=development

# Seller browser-push alerts (Web Push). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com
# Secret for the daily order-deadline job (Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Optional: seller support contact shown on Seller Hub > Help
NEXT_PUBLIC_SELLER_SUPPORT_EMAIL=
NEXT_PUBLIC_SELLER_SUPPORT_PHONE=

# Aadhaar OTP verification for sellers (mandatory before KYC).
# cashfree = Cashfree Secure ID (live). sandbox = test mode, OTP 123456, refused on production.
# Left empty: test mode in development, "not set up yet" on deployed sites.
AADHAAR_PROVIDER=
CASHFREE_VERIFICATION_CLIENT_ID=
CASHFREE_VERIFICATION_CLIENT_SECRET=
# production | sandbox (Cashfree's own test environment)
CASHFREE_VERIFICATION_ENV=sandbox

# Encrypts seller bank account numbers (AES-256-GCM). 32 random bytes, base64:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# Keep it secret and never change it once accounts are saved (they could no longer be read).
DATA_ENCRYPTION_KEY=

# Automatic seller payouts (7 days after delivery). test = simulated transfers, nothing is sent.
PAYOUT_PROVIDER=test
# Most AzadiMart pays out automatically per day before asking an admin to approve (in paise, 2 lakh = 20000000).
PAYOUT_DAILY_LIMIT_PAISE=20000000
