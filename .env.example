# Copy to .env.local in each app or export locally. Never commit real values.
# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/azadimart?sslmode=require

# Auth — generate unique secrets per environment
AUTH_SECRET=replace-with-32-plus-character-secret
AUTH_URL_STOREFRONT=http://localhost:3000
AUTH_URL_SELLER=http://localhost:3001
AUTH_URL_ADMIN=http://localhost:3002

# Bot check (Cloudflare Turnstile) on login and registration.
# Leave both empty to disable. Get free keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (always pass)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Object storage (S3-compatible: Cloudflare R2, AWS S3). Required in production
# for KYC documents and product media; keep the bucket PRIVATE (apps stream files).
# R2: STORAGE_REGION=auto, STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Leave bucket/keys empty in development to use a shared local folder
# (LOCAL_STORAGE_DIR, default <repo root>/.data).
STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Payments — leave empty until a provider is configured
PAYMENTS_DEFAULT_PROVIDER=cod
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Logistics — leave empty until a provider is configured
LOGISTICS_DEFAULT_PROVIDER=manual
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_API_TOKEN=
SHADOWFAX_API_KEY=

# Observability
LOG_LEVEL=info
NODE_ENV=development
